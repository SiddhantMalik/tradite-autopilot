# ── Tradite autopilot config (PAPER mode needs NO secrets) ──────────────────
TRADITE_START_CAPITAL=10000000     # paper book starting cash (₹) — 1 crore
TRADITE_TARGET_NAMES=8             # how many names to hold (equal-weight)
TRADITE_MONITOR_MIN=30             # exit-monitor frequency (minutes) in market hours
TRADITE_DECIDE_AT=15:45            # daily decision time, IST (HH:MM), post-close

# ── Risk limits (optional overrides; sensible defaults baked in) ─────────────
TRADITE_RISK_MAX_POS_PCT=0.15
TRADITE_RISK_MAX_SECTOR_PCT=0.30
TRADITE_RISK_MIN_CASH_PCT=0.05
TRADITE_RISK_MIN_RR=1.5
TRADITE_RISK_DD_HALT=0.15
TRADITE_DEFAULT_STOP_PCT=8         # initial stop %
TRADITE_TRAIL_PCT=8               # TRAILING stop % — ratchets up with the high (backtest-best); 0 = fixed
TRADITE_TARGET_PCT=50            # far ceiling; with trailing on, the trailing stop is the real exit
TRADITE_PARTIAL_TP_PCT=15        # book HALF the position at +15%, let the rest ride the trail
TRADITE_USE_VOLSIZE=true         # volatility-targeted position sizing (ON — activity-neutral, helps)

# Defensive cash-GATES — OFF by default: they idle the book (~98 trades → 28) and lowered return.
# Turn ON only if you want a lower-drawdown, less-active style.
TRADITE_USE_REGIME=false         # only buy when NIFTY is above its 200-day average
TRADITE_USE_TREND=false          # only buy names trading above their own 200-day average

# ── LIVE trading (leave UNSET until you've verified paper for weeks) ─────────
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=            # expires daily — must be refreshed
# TRADITE_AUTOPILOT_LIVE=I_UNDERSTAND   # ⚠ enables real orders; do NOT set yet
